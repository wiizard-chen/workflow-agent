{
  "name": "pi-workflow",
  "version": "0.1.0",
  "description": "三模式(idle/plan/build)需求流水线 pi 扩展:deepseek-pro 讨论 → glm-5.2 写 PRD → 主 session 拆子任务 → pi-subagents(deepseek-v4-flash)逐子任务实现+验证+commit → glm-5.2 review。",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "node --experimental-strip-types test/workflow-logic.test.ts",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/uninstall-skills.mjs",
    "skills:list": "node scripts/install-skills.mjs --list"
  },
  "pi": {
    "extensions": [
      "./extensions/workflow.ts",
      "./extensions/cache.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.0",
    "@types/node": "^22.20.1",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0"
  }
}
