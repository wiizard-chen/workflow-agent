{
  "name": "pi-workflow",
  "version": "0.1.0",
  "description": "plan/build 两模式需求流水线:GLM PRD writer、Beads task、串行 dev/reviewer、确定性验证与 GLM final review。",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "node --experimental-strip-types test/workflow-logic.test.ts",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/uninstall-skills.mjs",
    "skills:list": "node scripts/install-skills.mjs --list"
  },
  "pi": {
    "extensions": [
      "./extensions/workflow.ts",
      "./extensions/cache.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./.pi/agents"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.0",
    "@types/node": "^22.20.1",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0"
  }
}
