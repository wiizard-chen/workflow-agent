{
  "name": "pi-workflow",
  "version": "0.1.0",
  "description": "Plan/Build 双模式需求流水线 pi 扩展:deepseek-pro 讨论 → glm-5.2 写 PRD → deepseek-pro 拆子任务 → reasonix(deepseek-flash)逐子任务实现+验证+commit → glm-5.2 整体 review。",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/uninstall-skills.mjs",
    "skills:list": "node scripts/install-skills.mjs --list"
  },
  "pi": {
    "extensions": [
      "./extensions/workflow.ts",
      "./extensions/cache.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^22.20.1",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0"
  }
}
